{
  "rules": {
    ".read": false,
    ".write": false,
    "mathClassPolls": {
      "$owner": {
        "$room": {
          ".write": "auth != null && auth.uid === $owner && !newData.exists()",
          "meta": {
            ".read": "auth != null && (auth.uid === $owner || (data.child('open').val() === true && data.child('created').val() + 86400000 > now))",
            ".write": "auth != null && auth.uid === $owner && !data.exists() && newData.exists() && newData.child('open').val() === true && newData.child('created').val() === now",
            ".validate": "newData.hasChildren(['question','choices','open','created'])",
            "created": { ".validate": "newData.isNumber()" },
            "question": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "choices": {
              ".validate": "newData.hasChildren(['0','1'])",
              "$n": { ".validate": "$n.matches(/^[0-5]$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 80" }
            },
            "open": {
              ".write": "auth != null && auth.uid === $owner && data.exists() && newData.val() === false",
              ".validate": "newData.isBoolean()"
            },
            "$other": { ".validate": false }
          },
          "votes": {
            ".read": "auth != null && auth.uid === $owner",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && newData.isString() && root.child('mathClassPolls').child($owner).child($room).child('meta/open').val() === true && root.child('mathClassPolls').child($owner).child($room).child('meta/created').val() + 86400000 > now",
              ".validate": "newData.val().matches(/^[0-5]$/) && root.child('mathClassPolls').child($owner).child($room).child('meta/choices').hasChild(newData.val())"
            }
          }
        }
      }
    }
  }
}
